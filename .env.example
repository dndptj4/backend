# Supabase Postgres (Transaction pooler, port 6543)
# Dashboard > Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler (port 5432) — Prisma migrate / db push 전용
DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 로컬 서버 포트
PORT=4000

# 프론트엔드 origin (Vercel 배포 URL). 여러 개는 콤마로 구분
FRONTEND_URL="http://localhost:5173"
